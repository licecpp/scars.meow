# ─────────────────────────────────────────────────────────────────────
# halo.rip Discord bot - Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Bot token - Developer Portal -> Your App -> Bot -> Token
DISCORD_TOKEN=

# Application / client ID - Developer Portal -> Your App -> General Information
DISCORD_CLIENT_ID=

# Discord server ID (right-click server -> Copy Server ID).
# Required for instant slash command registration; without it global
# registration can take up to an hour to propagate.
DISCORD_GUILD_ID=

# ─── Local PostgREST (Supabase-compatible REST API) ───────────────────
# Both vars must match /opt/halo/website/.env so the bot and the site
# talk to the same data layer. Generated by setup/install-postgrest.sh.
SUPABASE_URL=http://127.0.0.1:3001
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional: direct Postgres ────────────────────────────────────────
# For raw SQL / bulk operations the REST API can't express cleanly.
DATABASE_URL=postgres://halo:CHANGE_ME@127.0.0.1:5432/halo

# ─── Logging ──────────────────────────────────────────────────────────
# Channel where the bot mirrors audit-log entries and operational events
# (right-click channel -> Copy Channel ID). The durable copy lives in
# the discord_audit_log Postgres table; this is the live stream.
LOG_CHANNEL_ID=

# Optional webhook URL used as a fallback log sink when LOG_CHANNEL_ID
# is unreachable. Useful if the bot can post via webhook but isn't yet
# in the channel.
DISCORD_LOG_WEBHOOK_URL=

# ─── Scheduled task channels ──────────────────────────────────────────
# Channel for the Monday-morning leaderboard. Leave blank to skip.
LEADERBOARD_CHANNEL_ID=

# Channel for the daily-8am stats card. Leave blank to skip.
STAFF_CHANNEL_ID=

# ─── Owner backstop ───────────────────────────────────────────────────
# If the bot_admins table ends up empty (migration not applied, table
# truncated), this Discord user ID can still operate admin commands.
# Normally unnecessary - bot_admins is the source of truth and the
# initial migration seeds the original owner.
BOT_OWNER_ID=
